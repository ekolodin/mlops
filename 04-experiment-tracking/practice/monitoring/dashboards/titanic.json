{
  "uid": "titanic-runtime",
  "title": "Titanic: запросы модели",
  "tags": ["mlops"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Запросы в секунду",
      "datasource": {"type": "prometheus", "uid": "course-prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
      "targets": [{"refId": "A", "expr": "sum by (variant) (rate(prediction_requests_total{job=\"titanic\"}[1m]))", "legendFormat": "{{variant}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 2, "type": "timeseries", "title": "Технические ошибки, %",
      "datasource": {"type": "prometheus", "uid": "course-prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
      "targets": [{"refId": "A", "expr": "100 * sum by (variant) (rate(prediction_requests_total{job=\"titanic\",status=\"error\"}[1m])) / sum by (variant) (rate(prediction_requests_total{job=\"titanic\"}[1m]))", "legendFormat": "{{variant}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "id": 3, "type": "timeseries", "title": "Длительность: добавьте запрос",
      "datasource": {"type": "prometheus", "uid": "course-prometheus"},
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 9},
      "targets": [{"refId": "A", "expr": "", "legendFormat": "{{variant}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    }
  ],
  "annotations": {"list": []},
  "templating": {"list": []}
}
